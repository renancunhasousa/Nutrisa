# Servidor: nunca use estas variáveis no código do navegador.
# 1º Provedor (Titular): Google Gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# 2º Provedor (1º Fallback): OpenAI (gpt-4o-mini com visão e texto)
OPENAI_API_KEY=

# 3º Provedor (2º Fallback): DeepSeek (deepseek-flash com visão e texto)
DEEPSEEK_API_KEY=

# Obrigatório na Vercel/produção. Informe o código no painel de IA da plataforma.
AI_ACCESS_TOKEN=

# Catálogo nutricional externo (somente servidor; nunca use VITE_)
FDC_API_KEY=
FDC_API_BASE_URL=https://api.nal.usda.gov/fdc/v1

# TBCA via Parse (somente backend; a API é independente, não oficial da TBCA)
TBCA_PARSE_API_KEY=
TBCA_PARSE_BASE_URL=https://api.parse.bot/scraper/f3f96c01-69e8-48d9-8e26-b6765980f9d6
